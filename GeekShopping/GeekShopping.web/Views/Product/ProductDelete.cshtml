@model GeekShopping.web.Models.ProductModel

<form asp-action="ProductDelete">

    <input asp-for="Id" hidden />
    <br />

    <div class="container border p-2">
        <h3 class="text-primaryq">Remover Producto</h3>

        <hr/>
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row mb-2">
                <div class="col-2">
                <label asp-for="Name" class="control-label pt-2" style="font-size=20px;">Name</label>
                </div>
                <div class="col-10">
                    <input asp-for="Name" class="form-control pb-2" disabled />
                </div>
            </div>
            
            <div class="row mb-2">
                <div class="col-2">
                    <label asp-for="CategoryName" class="control-label pt-2" style="font-size=20px;">Categoria</label>
                </div>
                <div class="col-10">
                    <input asp-for="CategoryName" class="form-control pb-2" disabled />
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-2 pb-3">
                    <label asp-for="Price" class="control-label pt-2" style="font-size=20px;">Preço</label>
                </div>
                <div class="col-10">
                    <input asp-for="Price" class="form-control" disabled />
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-2">
                    <label asp-for="Description" class="control-label pt-2" style="font-size:20px"></label>
                </div>
                <div class="col-10">
                    <textarea asp-for="Description" class="form-control" rows="5" disabled></textarea>
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-2">
                    <label asp-for="ImageURL" class="control-label pt-2" style="font-size:20px"></label>
                </div>
                <div class="col-10">
                    <input asp-for="ImageURL" class="form-control pb-2" disabled />
                </div>
            </div>
           
            <div class="row offset-1">
                <div class="col-5">
                    <a asp-action="ProductIndex" class="btn btn-primary form-control">Back to list</a>
                </div>
                <div class="col-5">
                    <input type="submit" value="Remover" class="btn btn-danger form-control" />
                </div>
            </div>
            
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
